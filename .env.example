APP_NAME=NEXUS
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus
TEST_DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus_test

JWT_SECRET=change-this-development-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

REDIS_URL=redis://localhost:6379/0
